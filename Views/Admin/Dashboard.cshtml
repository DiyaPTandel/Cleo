@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
}

<div class="admin-container-v3">
    <div class="admin-page-header-v3">
        <div class="admin-header-info-v3">
            <h1>Dashboard Overview</h1>
            <p>Welcome back, here's what's happening with your app today.</p>
        </div>
        <div class="admin-header-actions-v3">
            <button class="admin-btn-v3 secondary" onclick="window.location.reload()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                Refresh Data
            </button>
            <button class="admin-btn-v3 primary" onclick="window.location.href='/Admin/Content'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Content
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid-v3">
        <div class="stat-card-v3">
            <div class="stat-top-v3">
                <div class="stat-icon-v3 purple-v3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="stat-trend-v3 up">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    100%
                </div>
            </div>
            <div class="stat-main-v3">
                <span class="stat-label-v3">Total Users</span>
                <h2 class="stat-value-v3">@ViewBag.Stats.TotalUsers</h2>
            </div>
        </div>

        <div class="stat-card-v3">
            <div class="stat-top-v3">
                <div class="stat-icon-v3 pink-v3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.82-8.82 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </div>
                <div class="stat-trend-v3 up">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    100%
                </div>
            </div>
            <div class="stat-main-v3">
                <span class="stat-label-v3">Active Users</span>
                <h2 class="stat-value-v3">@ViewBag.Stats.ActiveUsers</h2>
            </div>
        </div>

        <div class="stat-card-v3">
            <div class="stat-top-v3">
                <div class="stat-icon-v3 blue-v3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                </div>
                <div class="stat-trend-v3 up">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    100%
                </div>
            </div>
            <div class="stat-main-v3">
                <span class="stat-label-v3">Monthly Signups</span>
                <h2 class="stat-value-v3">@ViewBag.Stats.TotalUsers</h2>
            </div>
        </div>

        <div class="stat-card-v3">
            <div class="stat-top-v3">
                <div class="stat-icon-v3 green-v3">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="stat-trend-v3 neutral">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </div>
            </div>
            <div class="stat-main-v3">
                <span class="stat-label-v3">Avg Cycle Length</span>
                <h2 class="stat-value-v3">28.5 days</h2>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Row -->
    <div class="dashboard-row-v3">
        <div class="chart-column-v3">
            <div class="content-card-v3" style="height: 100%;">
                <div class="card-header-v3">
                    <div>
                        <h3 class="card-title-v3">User Growth</h3>
                        <div class="card-options-v3" style="margin-top: 0.25rem;">Total Users : @ViewBag.Stats.TotalUsers <span class="trend-percent-v3 up">+100%</span> vs last 14 days</div>
                    </div>
                    <div style="display: flex; gap: 1rem; text-align: right;">
                        <div>
                            <div style="font-size: 0.65rem; font-weight: 700; color: #94A3B8; text-transform: uppercase;">New Today</div>
                            <div style="font-size: 1.25rem; font-weight: 800; color: #1E293B;">+0</div>
                        </div>
                        <div>
                            <div style="font-size: 0.65rem; font-weight: 700; color: #94A3B8; text-transform: uppercase;">Active (7d)</div>
                            <div style="font-size: 1.25rem; font-weight: 800; color: #1E293B;">@ViewBag.Stats.ActiveUsers</div>
                        </div>
                    </div>
                </div>
                <div class="chart-container-v3" style="position: relative; height: 260px; width: 100%;">
                    <canvas id="userGrowthChart"></canvas>
                </div>
            </div>
        </div>

        <div class="insights-column-v3">
            <div class="content-card-v3" style="height: 100%;">
                <div class="card-header-v3">
                    <div>
                        <h3 class="card-title-v3">Activity Insights</h3>
                        <div class="card-options-v3" style="margin-top: 0.25rem; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">Overall Breakdown</div>
                    </div>
                    <div class="total-logs-badge-v3">
                        <span class="total-logs-count-v3">@ViewBag.Stats.TotalLogs</span>
                        <span class="total-logs-label-v3">Total Logs</span>
                    </div>
                </div>
                
                <div class="activity-insights-list-v3">
                    <div class="insight-item-v3">
                        <div class="insight-label-v3">
                            <span class="small-logs-v3">LOGS</span>
                            <span class="bold-type-v3">PERIODS</span>
                        </div>
                        <div class="insight-bar-container-v3">
                            <div class="insight-bar-v3 periods" data-width="@(ViewBag.Stats.TotalLogs > 0 ? (ViewBag.ActivityInsights.Periods * 100 / ViewBag.Stats.TotalLogs) : 0)%">
                                <span class="insight-count-inside-v3">@ViewBag.ActivityInsights.Periods</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="insight-item-v3">
                        <div class="insight-label-v3">
                            <span class="small-logs-v3">LOGS</span>
                            <span class="bold-type-v3">MOODS</span>
                        </div>
                        <div class="insight-bar-container-v3">
                            <div class="insight-bar-v3 moods" data-width="@(ViewBag.Stats.TotalLogs > 0 ? (ViewBag.ActivityInsights.Moods * 100 / ViewBag.Stats.TotalLogs) : 0)%">
                                <span class="insight-count-inside-v3">@ViewBag.ActivityInsights.Moods</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="insight-item-v3">
                        <div class="insight-label-v3">
                            <span class="small-logs-v3">LOGS</span>
                            <span class="bold-type-v3">SYMPTOMS</span>
                        </div>
                        <div class="insight-bar-container-v3">
                            <div class="insight-bar-v3 symptoms" data-width="@(ViewBag.Stats.TotalLogs > 0 ? (ViewBag.ActivityInsights.Symptoms * 100 / ViewBag.Stats.TotalLogs) : 0)%">
                                <span class="insight-count-inside-v3">@ViewBag.ActivityInsights.Symptoms</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="insight-item-v3">
                        <div class="insight-label-v3">
                            <span class="small-logs-v3">LOGS</span>
                            <span class="bold-type-v3">NOTES</span>
                        </div>
                        <div class="insight-bar-container-v3">
                            <div class="insight-bar-v3 notes" data-width="@(ViewBag.Stats.TotalLogs > 0 ? (ViewBag.ActivityInsights.Notes * 100 / ViewBag.Stats.TotalLogs) : 0)%">
                                <span class="insight-count-inside-v3">@ViewBag.ActivityInsights.Notes</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Row -->
    <div class="dashboard-footer-row-v3">
        <div class="content-card-v3">
            <div class="card-header-v3">
                <div>
                    <h3 class="card-title-v3">Recent User Activity</h3>
                    <p class="subtitle-v3" style="margin-top: 0.25rem;">Latest user interactions from all logs</p>
                </div>
                <a id="viewAllActivity" class="view-all-v3">View All</a>
            </div>
            <div class="activity-table-container-v3">
                <table class="activity-table-v3">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Action</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="activityTableBody">
                        @for (int i = 0; i < ViewBag.RecentActivity.Count; i++)
                        {
                            var activity = ViewBag.RecentActivity[i];
                            <tr class="activity-row-v3 @(i >= 5 ? "hidden-row-v3" : "")" style="@(i >= 5 ? "display: none;" : "")">
                                <td>
                                    <div class="user-cell-v3">
                                        <div class="user-avatar-v3" style="background-color: #F1F5F9; color: #10517F; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                            @activity.User.Substring(0, 1)
                                        </div>
                                        <div>
                                            <span style="display: block;">@activity.User</span>
                                            <span class="user-email-v3">@activity.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@activity.Action</td>
                                <td>@activity.Time</td>
                                <td><span class="status-badge-v3 active">@activity.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- User Growth Chart ---
        const ctx = document.getElementById('userGrowthChart').getContext('2d');
        const labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
        const data = @Html.Raw(Json.Serialize(ViewBag.ChartData));

        const gradient = ctx.createLinearGradient(0, 0, 0, 260);
        gradient.addColorStop(0, 'rgba(139, 92, 246, 0.2)');
        gradient.addColorStop(1, 'rgba(139, 92, 246, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'User Growth',
                    data: data,
                    borderColor: '#8B5CF6',
                    borderWidth: 3,
                    fill: true,
                    backgroundColor: gradient,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: '#8B5CF6',
                    pointHoverBorderColor: '#fff',
                    pointHoverBorderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff',
                        titleColor: '#64748B',
                        bodyColor: '#1E293B',
                        bodyFont: { weight: '800' },
                        padding: 12,
                        cornerRadius: 10,
                        displayColors: false,
                        borderColor: '#F1F5F9',
                        borderWidth: 1,
                        callbacks: {
                            label: function(context) {
                                return 'users : ' + context.parsed.y;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9', borderDash: [5, 5], drawBorder: false },
                        ticks: { 
                            color: '#94A3B8', 
                            font: { size: 10, weight: '600' },
                            stepSize: 1
                        }
                    },
                    x: {
                        grid: { display: true, color: '#f1f5f9', borderDash: [5, 5], drawBorder: false },
                        ticks: { color: '#94A3B8', font: { size: 10, weight: '600' } }
                    }
                }
            }
        });

        // --- Animate Insight Bars ---
        setTimeout(() => {
            document.querySelectorAll('.insight-bar-v3').forEach(bar => {
                bar.style.width = bar.getAttribute('data-width');
            });
        }, 300);

        // --- View All Activity Toggle ---
        const viewAllBtn = document.getElementById('viewAllActivity');
        const hiddenRows = document.querySelectorAll('.hidden-row-v3');
        let isExpanded = false;

        viewAllBtn.addEventListener('click', function(e) {
            e.preventDefault();
            isExpanded = !isExpanded;
            
            hiddenRows.forEach(row => {
                row.style.display = isExpanded ? 'table-row' : 'none';
            });
            
            this.textContent = isExpanded ? 'View Less' : 'View All';
        });
    });
</script>
</div>
